# ── Database (Supabase) ──────────────────────────────────────────────
# From your Supabase project: Project Settings -> Database -> Connection string
# Use the "Transaction pooler" string (port 6543) for most deployments,
# or the direct connection (port 5432) for local development / migrations.
# Paste it exactly as Supabase gives it — postgres:// is auto-normalized
# to postgresql://, and sslmode=require is added automatically if missing.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional — only needed if you use Supabase's own SDK later (Storage,
# Realtime, Auth) rather than talking to Postgres directly, which is all
# this app does today.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
FLASK_APP=wsgi.py
FLASK_DEBUG=0
# Public URL this app is served at — used to build verification email links.
APP_BASE_URL=http://localhost:5000

# ── Email (Gmail SMTP, for account verification) ───────────────────────
# MAIL_PASSWORD must be a 16-character Gmail "App Password", not your
# normal Gmail password: Google Account -> Security -> 2-Step Verification
# (must be turned on first) -> App passwords -> generate one for "Mail".
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=youraddress@gmail.com
